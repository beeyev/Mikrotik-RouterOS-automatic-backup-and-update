#!/usr/bin/env bash
#
# Lab toolbox. `lab init` sets the RouterOS admin password and points
# /tool e-mail at Mailpit, then exits. `lab ros` runs RouterOS commands over SSH.

set -Eeuo pipefail
shopt -s inherit_errexit

readonly ROS_HOST='routeros'
readonly ROS_USER='admin'
readonly ROS_PASSWORD='admin'
readonly BOOT_TIMEOUT=900

log() {
  printf 'lab: %s\n' "$*" >&2
}

trap 'log "error: command failed at line ${LINENO}"' ERR

# Usage: rest PASSWORD PATH [curl args]
rest() {
  local password="$1" path="$2"
  shift 2
  curl -sS --fail-with-body --max-time 5 --user "${ROS_USER}:${password}" \
    --header 'content-type: application/json' "http://${ROS_HOST}/rest/${path}" "$@"
}

# A fresh CHR has an empty admin password. Changing it ends the REST session,
# so RouterOS answers 400 "Session closed"; the next pass checks the change.
wait_router() {
  local deadline=$((SECONDS + BOOT_TIMEOUT))
  until rest "${ROS_PASSWORD}" system/identity >/dev/null 2>&1; do
    if ((SECONDS >= deadline)); then
      log "error: RouterOS did not answer within ${BOOT_TIMEOUT}s"
      exit 1
    fi
    if rest '' system/identity >/dev/null 2>&1; then
      rest '' user/set --data "{\"numbers\":\"${ROS_USER}\",\"password\":\"${ROS_PASSWORD}\"}" >/dev/null 2>&1 || true
      log "setting admin password"
    fi
    sleep 2
  done
}

configure_router() {
  local out
  if ! out="$(rest "${ROS_PASSWORD}" tool/e-mail/set \
    --data '{"server":"mailpit","port":"1025","from":"routeros@lab.test","tls":"no"}')"; then
    log "error: RouterOS rejected the e-mail settings: ${out}"
    exit 1
  fi
  log "e-mail goes to mailpit:1025"
}

# Runs a RouterOS command, or opens a session without arguments.
ros() {
  export SSHPASS="${ROS_PASSWORD}"
  exec sshpass -e ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
    "${ROS_USER}@${ROS_HOST}" "$@"
}

case "${1:-}" in
  init)
    log "waiting for RouterOS"
    wait_router
    configure_router
    ;;
  ros)
    shift
    ros "$@"
    ;;
  *)
    log "usage: lab init | lab ros [COMMAND]"
    exit 64
    ;;
esac
